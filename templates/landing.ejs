<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Pathflow Jobs – Welcome</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body { background-color: #f5f5f9; }
      .page-wrap { min-height: 100vh; display:flex; flex-direction:column; }
      footer { margin-top:auto; padding:1rem 0; font-size:0.85rem; color:#777; }
    </style>
  </head>
  <body>
    <div class="page-wrap">
      <nav class="navbar navbar-light bg-white border-bottom mb-4">
        <div class="container">
          <a class="navbar-brand fw-bold" href="/">Pathflow Jobs</a>
        </div>
      </nav>

      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8">
            <div class="text-center mb-4">
              <h1 class="mb-3">Welcome to Pathflow Jobs</h1>
              <p class="text-muted">Are you a recruiter or an applicant?</p>
            </div>
            <div class="row g-4">
              <div class="col-md-6">
                <div class="card shadow-sm h-100">
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title">I am an Applicant</h5>
                    <p class="card-text text-muted">
                      Browse open positions and submit your application.
                    </p>
                    <a href="/applicant/info" class="btn btn-primary mt-auto">Continue as applicant</a>

                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card shadow-sm h-100">
                  <div class="card-body d-flex flex-column">
                    <h5 class="card-title">I am a Recruiter</h5>
                    <p class="card-text text-muted">
                      Log in to manage job postings and review applications.
                    </p>
                    <a href="/hr/login" class="btn btn-outline-secondary mt-auto">Recruiter login</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <footer>
        <div class="container text-center">
          Pathflow demo recruiting app
        </div>
      </footer>
    </div>
  </body>
</html>
