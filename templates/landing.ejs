<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Pathflow Jobs – Welcome</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body { background-color: #f5f5f9; }
      .page-wrap { min-height: 100vh; display: flex; flex-direction: column; }
      .hero { flex: 1; display: flex; align-items: center; }
      footer { margin-top: auto; padding: 1rem 0; font-size: 0.85rem; color: #777; }

      /* Centered applicant focus */
      .applicant-card { max-width: 560px; margin: 0 auto; }
    </style>
  </head>
  <body>
    <% const recruiterHref = (typeof isHR !== 'undefined' && isHR) ? '/hr/jobs' : '/hr/login'; %>

    <div class="page-wrap">
      <nav class="navbar navbar-light bg-white border-bottom">
        <div class="container">
          <a class="navbar-brand fw-bold" href="/">Pathflow Jobs</a>

          <!-- Recruiter: small button in the upper-right corner -->
          <div class="ms-auto">
            <a href="<%= recruiterHref %>" class="btn btn-sm btn-outline-secondary">Recruiter</a>
          </div>
        </div>
      </nav>

      <!-- Applicant: centered primary action -->
      <main class="hero">
        <div class="container py-5">
          <div class="text-center mb-4">
            <h1 class="mb-3">Welcome to Pathflow Jobs</h1>
            <p class="text-muted mb-0">Browse open positions and submit your application.</p>
          </div>

          <div class="card shadow-sm applicant-card">
            <div class="card-body p-4 p-md-5 text-center">
              <h4 class="mb-3">I am applicant</h4>
              <p class="text-muted mb-4">
                Start by filling in your details, then explore available jobs.
              </p>
              <a href="/applicant/info" class="btn btn-primary btn-lg px-4">Continue</a>
              <div class="mt-3">
                <small class="text-muted">Recruiter? Use the button in the top-right.</small>
              </div>
            </div>
          </div>
        </div>
      </main>

      <footer>
        <div class="container text-center">Pathflow demo recruiting app</div>
      </footer>
    </div>
  </body>
</html>

