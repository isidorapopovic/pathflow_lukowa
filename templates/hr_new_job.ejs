<%- include('partials/header', { title: 'New Job Posting' }) %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h1 class="h4 mb-3">New Job Posting</h1>
          <form method="POST" action="/hr/jobs/new">
            <div class="mb-3">
              <label class="form-label">Position name</label>
              <input name="position_name" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Company</label>
              <input name="company" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Expected years experience</label>
              <input type="number" name="expected_years_exp" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Expected salary (optional)</label>
              <input type="number" step="0.01" name="expected_salary" class="form-control" />
            </div>
            <div class="mb-3">
              <label class="form-label">Recruiter name</label>
              <input name="recruiter_name" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Position description</label>
              <textarea name="position_description" class="form-control" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Create job</button>
            <a href="/hr/jobs" class="btn btn-link">Cancel</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
